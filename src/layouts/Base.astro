---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { site, telHref } from '../config/site';
import { services } from '../data/services';
import { photo } from '../lib/photos';
import EstimateForm from '../components/EstimateForm.astro';
import Arrow from '../components/Arrow.astro';

interface Props {
  title: string;
  description: string;
  ogPhoto?: string;
  overHero?: boolean;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Set on /estimate/ so the header button scrolls to the on-page form instead of opening the dialog. */
  inlineForm?: boolean;
  /** Home page: header button jumps to the hero form. */
  heroForm?: boolean;
  /** Service pages: show the fixed mobile estimate bar. */
  stickyCta?: string;
}
const { title, description, heroForm = false, stickyCta = '', ogPhoto = 'bright-empty-room-new-drywall-windows', overHero = false, schema = [], noindex = false, inlineForm = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const og = await getImage({ src: photo(ogPhoto), width: 1200, height: 630, format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, site.url).href;

// Structured data: only fields backed by real configuration are emitted.
const business: Record<string, unknown> = {
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  url: site.url,
  image: ogUrl,
  areaServed: site.serviceAreas.map((name) => ({ '@type': 'City', name: `${name}, ${site.stateAbbr}` })),
};
if (site.phone) business.telephone = site.phone;
if (site.email) business.email = site.email;
if (site.address.street) {
  business.address = { '@type': 'PostalAddress', streetAddress: site.address.street, addressLocality: site.address.city, addressRegion: site.address.region, postalCode: site.address.postalCode, addressCountry: 'US' };
}
const sameAs = Object.values(site.social).filter(Boolean);
if (sameAs.length) business.sameAs = sameAs;
if (site.logo) business.logo = new URL(site.logo, site.url).href;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.name, publisher: { '@id': `${site.url}/#business` } },
    business,
    ...schema,
  ],
};
const path = Astro.url.pathname;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#12233a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body class={stickyCta ? 'has-sticky' : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" data-header>
      <div class="wrap">
        <div class="bar">
          <a class="brand" href="/" aria-label={`${site.name} home`}>
            {site.logo ? <img src={site.logo} alt={site.name} /> : <><span class="dot" aria-hidden="true"></span><span>{site.wordmark.primary} <span>{site.wordmark.secondary}</span></span></>}
          </a>
          <nav class="nav" aria-label="Primary">
            <ul class="nav-list">
              <li class="nav-drop" data-drop>
                <button type="button" aria-expanded="false" aria-controls="services-panel">Services <svg viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M1 1.5l5 5 5-5"/></svg></button>
                <div class="drop-panel" id="services-panel">
                  {services.map((s) => <a href={`/services/${s.slug}/`}>{s.name}</a>)}
                  <a class="all" href="/services/">See all services</a>
                </div>
              </li>
              <li><a href="/#how-it-works">How it works</a></li>
              <li><a href="/#good-to-know">Good to know</a></li>
              <li><a href="/#faq">FAQ</a></li>
            </ul>
            <a class="btn btn-main header-cta" href={inlineForm ? '#estimate-form' : '/estimate/'} data-estimate-open={inlineForm ? undefined : ''}>Get a free estimate</a>
            <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
              <span class="visually-hidden">Menu</span><i></i><i></i>
            </button>
          </nav>
        </div>
      </div>
    </header>
    <div class="mobile-menu" id="mobile-menu" data-mobile-menu inert>
      <ul>
        <li>
          <details>
            <summary>Services</summary>
            <ul>
              {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
              <li><a href="/services/">See all services</a></li>
            </ul>
          </details>
        </li>
        <li><a href="/#how-it-works">How it works</a></li>
        <li><a href="/#good-to-know">Good to know</a></li>
        <li><a href="/#faq">FAQ</a></li>
      </ul>
      <a class="btn btn-main" href="/estimate/">Get a free estimate</a>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/">
              {site.logo ? <img src={site.logo} alt={site.name} /> : <><span class="dot" aria-hidden="true"></span><span>{site.wordmark.primary} <span>{site.wordmark.secondary}</span></span></>}
            </a>
            <p>Friendly, tidy drywall work for homes and businesses in {site.city}, {site.state}.</p>
            {site.phone && <p><a href={telHref}>{site.phone}</a></p>}
            {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
            {site.address.street && <p>{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}</p>}
            {site.hours && <p>{site.hours}</p>}
          </div>
          <div>
            <h2>What we do</h2>
            <ul class="footer-services">
              {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Find your way</h2>
            <ul>
              <li><a href="/services/">All services</a></li>
              <li><a href="/#how-it-works">How it works</a></li>
              <li><a href="/#good-to-know">Good to know</a></li>
              <li><a href="/#area">Where we work</a></li>
              <li><a href="/#faq">FAQ</a></li>
              <li><a href="/estimate/">Free estimate</a></li>
              {site.social.facebook && <li><a href={site.social.facebook} rel="noopener">Facebook</a></li>}
              {site.social.instagram && <li><a href={site.social.instagram} rel="noopener">Instagram</a></li>}
              {site.social.googleBusiness && <li><a href={site.social.googleBusiness} rel="noopener">Google</a></li>}
            </ul>
          </div>
        </div>
        <div class="footer-base">
          <p>© {year} {site.name}</p>
          <p>Photos on this site are stock images for illustration, not our own projects, unless labeled.</p>
        </div>
      </div>
    </footer>

    {stickyCta && (
      <div class="sticky-cta"><a class="btn btn-main" href="/estimate/" data-estimate-open data-service={stickyCta}>Get a free estimate</a></div>
    )}

    {!inlineForm && (
      <dialog class="est-dialog" id="estimate-dialog" aria-labelledby="est-dialog-title">
        <div class="head">
          <div>
            <h2 id="est-dialog-title">Let’s get you an estimate</h2>
            <p>A few quick details and we’ll take it from there.</p>
          </div>
          <button class="close" type="button" data-estimate-close aria-label="Close estimate form">×</button>
        </div>
        <div class="body">
          <EstimateForm idPrefix="dlg" />
        </div>
      </dialog>
    )}

    <script>
      import '../scripts/site.ts';
      import '../scripts/estimate-form.ts';
    </script>
  </body>
</html>
