---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import { site } from '../../config/site';
import { services } from '../../data/services';
import { photo } from '../../lib/photos';

const title = 'Drywall Services in New Berlin, WI | New Berlin Elite Drywall';
const description = 'All our drywall services in New Berlin, WI: repair, patching, installation, taping, finishing, ceilings, water damage, popcorn removal, basements and garages.';
const schema = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services/` },
  ] },
  { '@type': 'ItemList', itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${site.url}/${s.slug}/` })) },
];
---
<Base title={title} description={description} schema={schema}>
  <section class="p-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Services</li></ol></nav>
      <h1>Drywall services in {site.city}</h1>
      <p class="big">Not sure what your job is called? Have a look through. Each page explains the work in plain language, and you can always just send us a photo.</p>
    </div>
  </section>
  <section class="sec" style="padding-top:clamp(2rem,4vw,3rem)">
    <div class="wrap cards">
      {services.map((s, i) => (
        <a class="card reveal" href={`/${s.slug}/`} style={`--d:${(i % 3) * 0.07}s`}>
          <figure><Picture src={photo(s.photo)} alt={s.photoAlt} widths={[400, 640]} sizes="(min-width: 58rem) 30vw, (min-width: 34rem) 46vw, 100vw" formats={['avif', 'webp']} loading={i < 3 ? 'eager' : 'lazy'} /></figure>
          <div><h2 style="font-size:1.22rem;letter-spacing:-.01em;margin-bottom:.4rem">{s.name}</h2><p>{s.short}</p><span class="link">Learn more <Arrow /></span></div>
        </a>
      ))}
    </div>
  </section>
  <section class="sec" style="padding-top:0">
    <div class="wrap"><div class="cta-panel"><div><h2>Still not sure?</h2><p>Send us a photo and a sentence. We’ll tell you what it needs.</p></div><a class="btn btn-sun" href="/estimate/" data-estimate-open>Get a free estimate <Arrow /></a></div></div>
  </section>
</Base>
