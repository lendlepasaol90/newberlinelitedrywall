---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Faq from '../components/Faq.astro';
import { site } from '../config/site';
import { services, serviceBySlug, type Service } from '../data/services';
import { photo } from '../lib/photos';
import { moreA } from '../data/more';
import { moreB } from '../data/more-b';
import { notes } from '../data/more-c';
import { installNote } from '../data/more-d';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
const url = `${site.url}/${s.slug}/`;
const related = s.related.map((slug) => serviceBySlug[slug]);
const plain = s.name.toLowerCase().replace('&', 'and');
const schema = [
  { '@type': 'Service', '@id': `${url}#service`, name: s.name, serviceType: s.name, description: s.description, url, provider: { '@id': `${site.url}/#business` }, areaServed: { '@type': 'City', name: `${site.city}, ${site.stateAbbr}` } },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services/` },
    { '@type': 'ListItem', position: 3, name: s.name, item: url },
  ] },
  { '@type': 'FAQPage', mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const extra = moreA[s.slug] ?? moreB[s.slug] ?? [];
const goodToKnow = [...(notes[s.slug] ?? []), ...(s.slug === 'drywall-installation' ? [installNote] : [])];
---
<Base title={s.title} description={s.description} ogPhoto={s.photo} schema={schema} stickyCta={s.slug}>
  <section class="s-hero">
    <div class="wrap s-hero-grid">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol><li><a href="/">Home</a></li><li><a href="/services/">Services</a></li><li aria-current="page">{s.name}</li></ol>
        </nav>
        <h1>{s.h1}</h1>
        <p class="big">{s.lede}</p>
        <a class="btn btn-main" href="/estimate/" data-estimate-open data-service={s.slug}>Get a free estimate <Arrow /></a>
      </div>
      <figure><Picture src={photo(s.photo)} alt={s.photoAlt} widths={[600, 900, 1300]} sizes="(min-width: 54rem) 45vw, 100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" /></figure>
    </div>
  </section>

  <div class="sec" style="padding-top:clamp(2rem,4vw,3rem)">
    <div class="wrap">
      <div class="article">
        <section class="quick"><h2>The short version</h2><p>{s.quick}</p></section>
        <section>{s.intro.map((p) => <p>{p}</p>)}</section>
        <section><h2>{s.what.h}</h2>{s.what.p.map((p) => <p>{p}</p>)}</section>
        <section>
          <h2>{s.situations.h}</h2>
          <ul class="tiles">{s.situations.items.map((it) => <li class="reveal"><h3>{it.t}</h3><p>{it.d}</p></li>)}</ul>
        </section>
        <section>
          <h2>{s.process.h}</h2>
          <ol class="path">{s.process.steps.map((st) => <li class="reveal"><h3>{st.t}</h3><p>{st.d}</p></li>)}</ol>
        </section>
        <section><h2>{s.materials.h}</h2>{s.materials.p.map((p) => <p>{p}</p>)}</section>
        <section>
          <h2>{s.benefits.h}</h2>
          <ul class="ticks">{s.benefits.items.map((b) => <li><h3>{b.t}</h3><p>{b.d}</p></li>)}</ul>
        </section>
        {extra.map((e) => (
          <section>
            <h2>{e.h}</h2>
            {e.p?.map((p) => <p>{p}</p>)}
            {e.list && <ul class="checks">{e.list.map((li) => <li>{li}</li>)}</ul>}
            {e.after?.map((p) => <p>{p}</p>)}
          </section>
        ))}
        <section>
          <h2>Before and after</h2>
          <BeforeAfter id={`ba-${s.slug}`} before={s.ba.before} after={s.ba.after} beforeAlt={s.ba.beforeAlt} afterAlt={s.ba.afterAlt} />
        </section>
        <section class="neighbor"><h2>{s.local.h}</h2>{s.local.p.map((p) => <p>{p}</p>)}</section>
        {goodToKnow.length > 0 && (
          <section class="gtk">
            <h2>Good to know</h2>
            {goodToKnow.map(([q, ans]) => <div><h3>{q}</h3><p>{ans}</p></div>)}
          </section>
        )}
        <section id="faq"><h2>Your questions about {plain}</h2><Faq items={s.faqs} /></section>
      </div>
    </div>
  </div>

  <section class="sec sec-mist">
    <div class="wrap">
      <div class="sec-head"><h2>You might also need</h2></div>
      <div class="cards" style="grid-template-columns:repeat(auto-fit,minmax(15rem,1fr))">
        {related.map((r) => (
          <a class="card" href={`/${r.slug}/`}>
            <figure><Picture src={photo(r.photo)} alt="" widths={[360, 600]} sizes="(min-width: 58rem) 22vw, 46vw" formats={['avif', 'webp']} loading="lazy" /></figure>
            <div><h3>{r.name}</h3><p>{r.short}</p><span class="link">Learn more <Arrow /></span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="cta-panel">
        <div>
          <h2>Want a price for this?</h2>
          <p>Tell us a little about your {plain.replace(' services', '')} project in {site.city} and we’ll send a free written estimate.</p>
        </div>
        <a class="btn btn-sun" href="/estimate/" data-estimate-open data-service={s.slug}>Get a free estimate <Arrow /></a>
      </div>
    </div>
  </section>
</Base>
